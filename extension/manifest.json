{
  "manifest_version": 3,
  "name": "ClipHutch — Web Media Capture",
  "version": "0.1.0",
  "description": "Your browser's media shelf. Detect and capture videos web pages load as you browse.",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
