{
  "name": "video-archive-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "NODE_ENV=production vite build",
    "package": "node -e \"require('node:fs').rmSync('dist.zip',{force:true})\" && cd dist && zip -r ../dist.zip . && cd ..",
    "test": "vitest",
    "audit:dist": "node scripts/audit-dist.js",
    "assets:store": "npm run build && node scripts/capture-store-assets.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "fast-xml-parser": "^5.7.2",
    "m3u8-parser": "^7.2.0",
    "mp4box": "^2.3.0",
    "mux.js": "^6.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
