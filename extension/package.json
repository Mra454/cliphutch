{
  "name": "video-archive-extension",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production",
    "build:development": "node scripts/release-pipeline.mjs build-development",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:release": "node --test scripts/release-foundation.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs --extension-dir dist",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:development": "node scripts/release-pipeline.mjs verify-development",
    "verify:source": "node scripts/release-pipeline.mjs verify-source",
    "package": "node scripts/release-pipeline.mjs package",
    "verify:package": "node scripts/release-pipeline.mjs verify-package",
    "audit:dist": "node scripts/audit-dist.js",
    "audit:dist:development": "node scripts/audit-dist.js --allow-development",
    "assets:store": "npm run build && node scripts/capture-store-assets.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "fast-xml-parser": "^5.7.2",
    "m3u8-parser": "^7.2.0",
    "mp4box": "^2.3.0",
    "mux.js": "^6.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
