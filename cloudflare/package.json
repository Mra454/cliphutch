{
  "name": "cliphutch-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy:staging": "node scripts/run-wrangler-operation.mjs deploy staging",
    "versions:production:upload": "node scripts/run-wrangler-operation.mjs versions-upload production",
    "versions:production:stage": "node scripts/run-wrangler-operation.mjs versions-stage production",
    "versions:production:promote": "node scripts/run-wrangler-operation.mjs versions-promote production",
    "types": "wrangler types worker-configuration.d.ts --strict-vars false",
    "types:check": "npm run types -- --check",
    "typecheck": "npm run types:check && tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && wrangler deploy --env staging --dry-run --outdir dist/dry-run",
    "db:local:bootstrap": "node scripts/run-wrangler-operation.mjs bootstrap local",
    "db:staging:bootstrap": "node scripts/run-wrangler-operation.mjs bootstrap staging",
    "db:staging:migrations:list": "node scripts/run-wrangler-operation.mjs migrations-list staging",
    "db:staging:migrations:apply": "node scripts/run-wrangler-operation.mjs migrations-apply staging",
    "db:production:migrations:list": "node scripts/run-wrangler-operation.mjs migrations-list production",
    "db:production:migrations:apply": "node scripts/run-wrangler-operation.mjs migrations-apply production",
    "smoke:version": "node scripts/assert-worker-version.mjs",
    "tail:staging": "wrangler tail --env staging",
    "tail:production": "wrangler tail --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
